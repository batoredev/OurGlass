{
  "name": "@ourglass/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "reset": "node --env-file-if-exists=.env scripts/migrate.mjs --reset"
  },
  "dependencies": {
    "@ourglass/shared": "workspace:*",
    "pg": "^8.13.0",
    "node-pg-migrate": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
