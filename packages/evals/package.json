{
  "name": "@ourglass/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.fixtures.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval:ai": "vitest run --config vitest.ai.config.ts",
    "check:models": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.live.config.ts src/models.live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@ourglass/shared": "workspace:*"
  },
  "devDependencies": {
    "@ourglass/api": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
