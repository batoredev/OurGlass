{
  "name": "@ourglass/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern \"**/.open-next/**\"",
    "test": "vitest run",
    "preview": "node scripts/build-worker.mjs && opennextjs-cloudflare preview",
    "deploy:staging": "node scripts/build-worker.mjs && opennextjs-cloudflare deploy -- --env staging",
    "deploy": "node scripts/build-worker.mjs && opennextjs-cloudflare deploy",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@ourglass/api": "workspace:*",
    "@ourglass/db": "workspace:*",
    "@ourglass/shared": "workspace:*",
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  }
}
