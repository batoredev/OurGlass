{
  "name": "@ourglass/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@ourglass/db": "workspace:*",
    "@ourglass/shared": "workspace:*",
    "chrono-node": "2.10.1",
    "fastify": "^5.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "exports": {
    "./assistant": {
      "types": "./dist/assistant/index.d.ts",
      "default": "./dist/assistant/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./reminders/poller": {
      "types": "./dist/reminders/poller.d.ts",
      "default": "./dist/reminders/poller.js"
    }
  }
}
