# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Postgres (matches docker-compose.yml's postgres service)
DATABASE_URL=postgres://ourglass:ourglass@localhost:5432/ourglass_dev

# Anthropic API — used from Phase 2 onward for extraction and response
# generation. Never set this in a workflow a fork PR can trigger (see
# docs/EXECUTION-PLAN.md's GitHub Actions section).
ANTHROPIC_API_KEY=

# Voyage AI — embeddings, from Phase 4 onward (semantic memory and hybrid
# retrieval). Anthropic ships no embeddings API and names Voyage as its
# recommended provider; see docs/PHASE-4-DESIGN.md §1.
#
# OPTIONAL. Without it the app still runs: embedding is deliberately not
# required on the write path (§2.2), so a memory stores with a NULL embedding
# and is invisible to semantic search while staying fully visible to
# structured queries. Degraded, not broken.
#
# Same fork-PR rule as above — never set this in a workflow a fork can trigger.
VOYAGE_API_KEY=

# apps/api
PORT=3001

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
