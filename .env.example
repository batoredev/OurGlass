# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Postgres (matches docker-compose.yml's postgres service)
DATABASE_URL=postgres://ourglass:ourglass@localhost:5432/ourglass_dev

# ---------------------------------------------------------------------------
# AI providers
#
# The assistant tries providers IN ORDER and stops at the first that answers.
# An unset key is a CHOICE, not an error: that provider is skipped. Only when
# NOTHING is configured does a turn fail, and it says so by name.
#
# Never set any of these in a workflow a fork PR can trigger — see
# docs/EXECUTION-PLAN.md's GitHub Actions section.
# ---------------------------------------------------------------------------

# Priority order. Defaults to claude,gemini — qwen joins only when
# OLLAMA_BASE_URL is set, so a machine with no Ollama does not pay a
# connection timeout on every fallback.
AI_PROVIDER_ORDER=

# Per-stage overrides. Interpret and Respond need not use the same chain.
AI_INTERPRET_ORDER=
AI_RESPOND_ORDER=

AI_REQUEST_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_ENABLE_FALLBACK=

# The Read stage (Phase 6 uploads). Unset, it uses AI_INTERPRET_ORDER's order,
# skipping any provider that cannot read the input (Qwen reads text, not
# images). Its wait defaults to 60s — a 10k-token document is not a sentence.
AI_READ_ORDER=
AI_READ_TIMEOUT_MS=

# The Respond stage's own budget (default 3000). It is short on purpose: the
# write has already committed, so a slow reply must not make a durable turn
# look failed. But Gemini measures 10-19s on this stage and therefore ALWAYS
# falls back to the template at 3s. Raise this if Gemini or Qwen writes your
# replies; leave it alone for Claude.
AI_RESPOND_TIMEOUT_MS=

# Claude — the primary provider. Sonnet for Interpret, Haiku for Respond.
# NEVER Opus: owner decision, recorded in docs/DECISIONS.md.
ANTHROPIC_API_KEY=
ANTHROPIC_INTERPRET_MODEL=
ANTHROPIC_RESPONSE_MODEL=

# Gemini — the second provider. Defaults verified callable 2026-09-18; see
# apps/api/src/ai/gemini.ts.
GEMINI_API_KEY=
GEMINI_INTERPRET_MODEL=
GEMINI_RESPONSE_MODEL=

# Free backup providers (apps/api/src/ai/openai-compat.ts), tried after Gemini.
# Each is free with a sign-up key; a missing key just skips that provider.
# Model catalogs change often — override the model if a default disappears.
#   Groq        https://console.groq.com/keys      default llama-3.3-70b-versatile
#   Cerebras    https://cloud.cerebras.ai           default gpt-oss-120b
#   OpenRouter  https://openrouter.ai/keys          default openrouter/free
# ⚠ Free tiers may use what you send to improve their models — check each
#   provider's data terms before sending real personal data.
# Deployed: `supabase secrets set GROQ_API_KEY=...` (and so on).
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Qwen via Ollama — the local/private provider. Setting the base URL is the
# opt-in that puts qwen in the default chain. A Supabase Edge Function cannot
# reach localhost, so in production this must be a host it can resolve.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Voyage AI — embeddings (semantic memory and hybrid retrieval, Phase 4).
#
# OPTIONAL. Without it the app still runs: embedding is deliberately not
# required on the write path, so a memory stores with a NULL embedding and is
# invisible to semantic search while staying fully visible to structured
# queries. Degraded, not broken.
#
# With it: the poller (`pnpm dev` locally, the cron in production) embeds new
# memories on its next tick, and corrections ("forget that Arun works on
# backend") use hybrid recall, so a paraphrase is found instead of declined.
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Access control (docs/PHASE-7-PERMISSIONS-DESIGN.md §8)
#
# OURGLASS_ACCESS_TOKEN — REQUIRED in any deployed environment. At least 32
# characters; shorter is refused as a misconfiguration. Browsers sign in once
# at /login, keep the token, and send it as `Authorization: Bearer <token>`
# (apps/web/lib/session.ts); scripts do the same. Rotating it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Deployed: `supabase secrets set OURGLASS_ACCESS_TOKEN=...` — never in a committed file.
#
# ENABLE_DEMO_ENDPOINT=true — LOCAL DEVELOPMENT ONLY. With no token set, it
# opens every route with no sign-in. Ignored whenever a token is set. With
# neither, every data route answers 404.
# ---------------------------------------------------------------------------
OURGLASS_ACCESS_TOKEN=
ENABLE_DEMO_ENDPOINT=

# ---------------------------------------------------------------------------
# Spend cap on /api/turn (apps/edge/app/api/_rate-limit.ts)
#
# Every turn spends model tokens, so these bound what a leaked token or a
# runaway script can cost. Defaults 10 per minute and 200 per day — the owner's
# budget, decided 2026-09-24 (docs/DECISIONS.md). A refused turn answers 429 and
# writes nothing. 0 disables one window; anything unparseable keeps the
# default rather than silently removing the cap. Deployed: `supabase secrets set`.
# ---------------------------------------------------------------------------
TURN_LIMIT_PER_MINUTE=
TURN_LIMIT_PER_DAY=

# ---------------------------------------------------------------------------
# Alerts (apps/edge/lib/alert.ts) — decided 2026-09-24: a chat webhook.
#
# A Slack or Discord incoming-webhook URL. When set, the app posts one message
# when the reminder cron fails or when every AI model fails for a message —
# the two outages that would otherwise go unnoticed. At most one per kind per
# 15 minutes. Alerts carry operational facts only, never what the user said.
# The URL is a CREDENTIAL (anyone holding it can post to your channel):
# deployed, it goes in with `supabase secrets set ALERT_WEBHOOK_URL=...`.
# ---------------------------------------------------------------------------
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# File uploads (Phase 6, docs/PHASE-6-DESIGN.md) — decided 2026-09-24:
# Supabase Storage. OPTIONAL: without both, the 📎 upload answers "file uploads
# aren't set up" and everything else works.
#
# SUPABASE_URL        https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY a secret key (sb_secret_…) or the legacy service_role key.
#   ⚠ It BYPASSES ROW LEVEL SECURITY. Server-side only; never in a browser,
#   never in a committed file. Deployed, the names are STORAGE_URL and
#   STORAGE_SECRET_KEY (`supabase secrets set` skips the reserved SUPABASE_ prefix).
#
# The private `documents` bucket creates itself on the first upload.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Hosting: static site on Cloudflare Pages, API on Supabase Edge Functions
# (docs/DEPLOYMENT-DESIGN.md).
#
# NEXT_PUBLIC_API_URL  Where the web app finds the API. Baked into the static
#   site at build time, so on Cloudflare Pages set it in the project settings:
#   https://<project-ref>.supabase.co/functions/v1
#   Locally, `pnpm dev` serves the API on http://localhost:8787.
#
# ALLOWED_ORIGINS      Comma-separated origins allowed to call the API from a
#   browser, e.g. https://ourglass.pages.dev — exact matches, no wildcards.
#   Deployed: `supabase secrets set ALLOWED_ORIGINS=...`. Locally it defaults
#   to http://localhost:3000.
#
# CRON_SECRET          32+ characters. The pg_cron job sends it to the
#   `reminders` function (supabase/cron/schedule-reminders.sql), which refuses
#   any call without it. Deployed only: `supabase secrets set CRON_SECRET=...`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=
CRON_SECRET=
