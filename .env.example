# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Postgres (matches docker-compose.yml's postgres service)
DATABASE_URL=postgres://ourglass:ourglass@localhost:5432/ourglass_dev

# ---------------------------------------------------------------------------
# AI providers
#
# The assistant tries providers IN ORDER and stops at the first that answers.
# An unset key is a CHOICE, not an error: that provider is skipped. Only when
# NOTHING is configured does a turn fail, and it says so by name.
#
# Never set any of these in a workflow a fork PR can trigger — see
# docs/EXECUTION-PLAN.md's GitHub Actions section.
# ---------------------------------------------------------------------------

# Priority order. Defaults to claude,gemini — qwen joins only when
# OLLAMA_BASE_URL is set, so a machine with no Ollama does not pay a
# connection timeout on every fallback.
AI_PROVIDER_ORDER=

# Per-stage overrides. Interpret and Respond need not use the same chain.
AI_INTERPRET_ORDER=
AI_RESPOND_ORDER=

AI_REQUEST_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_ENABLE_FALLBACK=

# Claude — the primary provider. Sonnet for Interpret, Haiku for Respond.
# NEVER Opus: owner decision, recorded in docs/DECISIONS.md.
ANTHROPIC_API_KEY=
ANTHROPIC_INTERPRET_MODEL=
ANTHROPIC_RESPONSE_MODEL=

# Gemini — the second provider. Model names are UNVERIFIED defaults; see
# apps/api/src/ai/gemini.ts.
GEMINI_API_KEY=
GEMINI_INTERPRET_MODEL=
GEMINI_RESPONSE_MODEL=

# Qwen via Ollama — the local/private provider. Setting the base URL is the
# opt-in that puts qwen in the default chain. A Cloudflare Worker cannot reach
# localhost, so in production this must be a host the Worker can resolve.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Voyage AI — embeddings (semantic memory and hybrid retrieval, Phase 4).
#
# OPTIONAL. Without it the app still runs: embedding is deliberately not
# required on the write path, so a memory stores with a NULL embedding and is
# invisible to semantic search while staying fully visible to structured
# queries. Degraded, not broken.
#
# With it: the poller (`pnpm dev` locally, the cron in production) embeds new
# memories on its next tick, and corrections ("forget that Arun works on
# backend") use hybrid recall, so a paraphrase is found instead of declined.
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Access control (docs/PHASE-7-PERMISSIONS-DESIGN.md §8)
#
# OURGLASS_ACCESS_TOKEN — REQUIRED in any deployed environment. At least 32
# characters; shorter is refused as a misconfiguration. Browsers sign in once
# at /login and receive an HttpOnly session cookie; scripts send
# `Authorization: Bearer <token>`. Rotating the token signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Deployed: `npx wrangler secret put OURGLASS_ACCESS_TOKEN` — never in wrangler.toml.
#
# ENABLE_DEMO_ENDPOINT=true — LOCAL DEVELOPMENT ONLY. With no token set, it
# opens every route with no sign-in. Ignored whenever a token is set. With
# neither, every data route answers 404.
# ---------------------------------------------------------------------------
OURGLASS_ACCESS_TOKEN=
ENABLE_DEMO_ENDPOINT=
